{
  "name": "nlide",
  "private": true,
  "version": "0.1.0",
  "description": "Natural Language IDE — intent canvas",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "insforge:login": "insforge login",
    "insforge:link": "insforge link",
    "insforge:current": "insforge current",
    "insforge:migrate": "insforge db migrations up --all -y",
    "insforge:migrate:new": "insforge db migrations new",
    "insforge:deploy:api": "node scripts/bundle-nlide-api.mjs && npx @insforge/cli functions deploy nlide-api --file insforge/functions/nlide-api/dist/index.ts",
    "sync:translator": "node scripts/sync-translator-spec.mjs",
    "bundle:api": "node scripts/bundle-nlide-api.mjs",
    "insforge:invoke:health": "insforge functions invoke nlide-api --data '{\"action\":\"health\"}'",
    "insforge:invoke:route-smoke": "insforge functions invoke nlide-api --data '{\"action\":\"route\",\"message\":\"Users should be able to pan and zoom the canvas.\",\"context\":{\"projectName\":\"NLIDE Demo\",\"centerCardId\":\"product\",\"cards\":[{\"id\":\"F-001\",\"type\":\"feature\",\"title\":\"Canvas interaction\",\"body\":\"Pan, zoom, and navigate the intent canvas.\",\"specRef\":{\"file\":\"features.md\",\"anchor\":\"F-001\"},\"status\":\"approved\"}],\"edges\":[]}}'",
    "insforge:invoke:route-golden": "insforge functions invoke nlide-api --data '{\"action\":\"route-golden\"}'",
    "insforge:invoke:write-features-golden": "insforge functions invoke nlide-api --data '{\"action\":\"write-features-golden\"}'",
    "insforge:invoke:phase4-smoke": "insforge functions invoke nlide-api --data '{\"action\":\"phase4-smoke\"}'",
    "insforge:invoke:canvas-mapper-golden": "insforge functions invoke nlide-api --data '{\"action\":\"canvas-mapper-golden\"}'",
    "write:spec": "node scripts/write-exported-spec.mjs",
    "test:execution-handoff": "node scripts/test-execution-handoff.mjs",
    "insforge:invoke:export-smoke": "insforge functions invoke nlide-api --data '{\"action\":\"export-smoke\"}'",
    "insforge:secrets:setup": "node scripts/print-insforge-secrets-help.js"
  },
  "devDependencies": {
    "@insforge/cli": "^0.1.87"
  }
}
