# InsForge nlide-api function URL (no trailing slash)
# Get this after: npm run insforge:deploy:api
VITE_INSFORGE_FUNCTION_URL=

# Local dev: copy to .env.local (gitignored).
# Production: frontend/.env.production (committed) — used automatically by `vite build`.

# Example:
# VITE_INSFORGE_FUNCTION_URL=https://your-project.us-east.insforge.app/functions/nlide-api
